# xAI Grok
XAI_API_KEY=xai-...

# OpenAI (ChatGPT / Codex / GPT-4o / o1)
OPENAI_API_KEY=sk-...

# Optional – GitHub Models or Copilot-style
GITHUB_TOKEN=ghp_...
WHISPER_CPP_BIN=
WHISPER_CPP_MODEL=

# Ollama local server (install with `brew install ollama`, then run `ollama serve`)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b

# Hugging Face Inference Router (requires your own HF token)
HF_BASE_URL=https://router.huggingface.co/v1
HF_API_KEY=hf_...
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# Private-LAN Windows GPU worker. Export reviewed API workflows into workflows/.
COMFYUI_BASE_URL=http://192.168.4.50:8188
COMFYUI_IMAGE_WORKFLOW=
COMFYUI_VIDEO_WORKFLOW=
