{
  "1": {
    "class_type": "LoadImage",
    "inputs": { "image": "{{SOURCE_IMAGE}}" }
  },
  "2": {
    "class_type": "ImageScaleBy",
    "inputs": {
      "image": ["1", 0],
      "upscale_method": "lanczos",
      "scale_by": "{{SCALE_BY}}"
    }
  },
  "3": {
    "class_type": "SaveImage",
    "inputs": { "filename_prefix": "MasterChief-Upscale", "images": ["2", 0] }
  }
}
