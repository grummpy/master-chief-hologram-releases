{
  "name": "master-chief-hologram",
  "version": "1.39.0",
  "description": "Desktop holographic Master Chief AI companion – multi-model prompt runner",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build:three": "esbuild three-scene.js --bundle --format=iife --outfile=three-scene.bundle.js",
    "build:manifest": "node scripts/generate-build-info.js",
    "release:manifest": "node scripts/generate-release-manifest.js",
    "inspect:mac": "node scripts/inspect-mac-package.js",
    "release:readiness": "zsh scripts/check-macos-release-readiness.sh",
    "release:local": "npm test && npm run test:assets && npm run test:visual && npm audit --omit=dev && npm run dist:mac",
    "dist:mac": "npm run build:three && npm run build:manifest && electron-builder --mac dir && npm run inspect:mac",
    "launch:mac": "zsh scripts/launch-mac.sh",
    "test": "node --test tests/*.test.js",
    "test:assets": "node scripts/validate-assets.js",
    "test:visual": "node scripts/validate-visual-regression.js",
    "test:p0": "node scripts/run-p0-evaluation.js",
    "test:p2": "node scripts/run-p2-assessment.js",
    "test:comfy-live": "node scripts/live-comfy-acceptance.js 20",
    "test:comfy-fidelity": "node scripts/comfy-prompt-fidelity.js",
    "test:comfy-openpose": "node scripts/live-openpose-readiness.js",
    "test:comfy-pose-extractor": "node scripts/live-pose-extractor-readiness.js",
    "test:comfy-faceid": "node scripts/live-faceid-readiness.js",
    "test:comfy-structure": "node scripts/live-structure-controls-readiness.js",
    "test:comfy-remacri": "node scripts/live-remacri-readiness.js",
    "test:comfy-detail": "node scripts/live-detail-controls-readiness.js",
    "test:comfy-identity": "node scripts/live-identity-benchmark.js"
  },
  "dependencies": {
    "docx": "^9.5.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "officeparser": "^8.0.0",
    "pptxgenjs": "^4.0.1",
    "three": "^0.180.0"
  },
  "author": "grummpy",
  "license": "MIT",
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.12"
  },
  "overrides": {
    "image-size": "2.0.4",
    "uuid": "11.1.1"
  },
  "build": {
    "appId": "com.grummpy.master-chief-hologram",
    "productName": "Master Chief Hologram",
    "afterPack": "scripts/after-pack.js",
    "asar": true,
    "files": [
      "security.js",
      "credential-store.js",
      "tool-registry.js",
      "local-tool-executor.js",
      "rag-index.js",
      "voice-diagnostics.js",
      "voice-installation.js",
      "voice-setup-ui.js",
      "huggingface-setup.js",
      "audio-production.js",
      "document-generator.js",
      "file-ingestion.js",
      "productivity-artifacts.js",
      "ollama-evaluator.js",
      "public-research.js",
      "microphone-access.js",
      "autocomplete.js",
      "local-routing.js",
      "local-ai-manifest.js",
      "ollama-runtime.js",
      "local-ai-manifest.json",
      "local-ai-audit.js",
      "connector-registry.js",
      "project-store.js",
      "plugin-catalog.js",
      "scheduler-store.js",
      "monitor-store.js",
      "windows-worker-control.js",
      "operational-readiness.js",
      "comfyui-client.js",
      "media-job-ledger.js",
      "image-output-validator.js",
      "image-benchmark.js",
      "workflow-registry.js",
      "png-workflow-metadata.js",
      "reference-studio-store.js",
      "agent-runner.js",
      "agent-task-ledger.js",
      "context-engine.js",
      "context-memory-store.js",
      "conversation-store.js",
      "provider-contract.js",
      "diagnostics-store.js",
      "repository-index.js",
      "extension-sdk.js",
      "response-quality.js",
      "mcp-registry.js",
      "crash-recovery.js",
      "web-evidence.js",
      "local-model-router.js",
      "verification-engine.js",
      "p0-evaluation.js",
      "capability-gap-audit.js",
      "artifact-links.js",
      "build-info.json",
      "LICENSE",
      "main.js",
      "preload.js",
      "renderer.js",
      "reference-studio.js",
      "three-scene.js",
      "three-scene.bundle.js",
      "index.html",
      "styles.css",
      "audit-upgrades.css",
      "package.json",
      "assets/**/*",
      "workflows/**/*",
      "recipes/**/*",
      "evaluation/**/*"
    ],
    "mac": {
      "hardenedRuntime": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Master Chief Hologram transcribes a command only after you press MIC.",
        "NSLocalNetworkUsageDescription": "Master Chief Hologram connects to your private Windows ComfyUI worker to submit approved creative jobs and retrieve their results.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "localhost": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": false
            },
            "127.0.0.1": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": false
            },
            "192.168.4.31": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": false
            }
          }
        }
      },
      "category": "public.app-category.productivity",
      "target": [
        "dir"
      ],
      "icon": "assets/icon.png"
    }
  }
}
